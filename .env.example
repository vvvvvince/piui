# cp .env.example .env && docker compose up -d
#
# REQUIRED. Without it compose refuses to start (sessions would die on every restart).
#   openssl rand -hex 32
PIUI_SESSION_SECRET=change-me-openssl-rand-hex-32

# Login for the web UI. CHANGE THESE before publishing the port anywhere.
PIUI_USERNAME=test
PIUI_PASSWORD=test

# The bind-mounted ./workspaces must be writable by the container's uid 10001:
#   mkdir -p workspaces && sudo chown 10001:10001 workspaces   (or: chmod 777 workspaces)
#
# Host port; the container is published to 127.0.0.1 only.
PIUI_PUBLISH_PORT=8787
TZ=UTC

# Web search: none | brave | tavily | searxng
PIUI_SEARCH_PROVIDER=none
PIUI_SEARCH_API_KEY=
# For the bundled SearXNG: docker compose --profile search up -d
# PIUI_SEARCH_PROVIDER=searxng
# PIUI_SEARXNG_URL=http://searxng:8080
# Let web_fetch and HTTP tools reach private/loopback addresses (off by default — this is the
# SSRF guard, only turn it on for a trusted internal network).
# PIUI_ALLOW_PRIVATE_HTTP_TOOLS=1

# Run limits
PIUI_MAX_CONCURRENT_RUNS=4
PIUI_MAX_RUN_MINUTES=30

# Image to run; `docker compose build` writes piui:latest.
PIUI_IMAGE=piui:latest
